{
  "name": "@wagq/dsh-browser",
  "version": "0.0.1",
  "description": "Bookmark strip for DeepSeek Harness: a compact bookmark bar on top, a large inline browser below, and a desktop/mobile user agent per bookmark.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bookmarks",
    "browser",
    "webview"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "tools",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}











